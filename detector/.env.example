# JPEG snapshot from go2rtc (must match a stream name in gateway/go2rtc.yaml)
GO2RTC_FRAME_URL=http://127.0.0.1:1990/api/frame.jpeg?src=cam01
CAMERA_ID=CAM-01
SECTOR=Sector B

# Optional Tapo RTSP fallback if the JPEG URL is down
RTSP_URL=

# Laravel API — DETECTOR_KEY must match api/.env
API_BASE=http://127.0.0.1:8000/api
DETECTOR_KEY=tidalwatch-detector-local

INTERVAL_S=1.5
CONF=0.35
MODEL_NAME=yolov8s-worldv2.pt
HOST=127.0.0.1
PORT=8092

# Used only by train_from_roboflow.py — leave empty if you are not training
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_MODEL_IDS=
