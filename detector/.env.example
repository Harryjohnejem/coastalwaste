# Live monitoring — multi-stream detector
# GO2RTC_BASE=http://127.0.0.1:1990
# CAMERA_ID=CAM-01
# SECTOR=Sector B

# Shared Tapo Camera Account (RTSP) — used when DETECTOR_STREAMS entries
# supply rtsp_path instead of a full rtsp_url. Never expose these to the browser.
# TAPO_RTSP_USER=
# TAPO_RTSP_PASS=
# TAPO_HOST=192.168.1.13

# Second camera direct-RTSP fallback only. Live capture uses go2rtc JPEG.
# Put the Camera Account in gateway/.env (TAPO2_*), not in this file's stream JSON.
# TAPO2_RTSP_USER=
# TAPO2_RTSP_PASS=
# TAPO2_HOST=192.168.1.18

# Wide lenses: cam01 is the first Tapo, cam02 is the second. cam04 is the unused telephoto.
# Leave DETECTOR_STREAMS empty to use legacy single CAMERA_ID + RTSP_URL.
# DETECTOR_STREAMS=[{"camera_id":"CAM-01","go2rtc_src":"cam01","rtsp_path":"/stream1","label":"Paco Wide-Angle","enabled":true},{"camera_id":"CAM-02","go2rtc_src":"cam02","rtsp_path":"/stream1","tapo_env":"TAPO2","label":"Paco Wide-Angle","sector":"Paco","enabled":true}]

# Legacy single-stream fallback (used when DETECTOR_STREAMS is empty)
# GO2RTC_FRAME_URL=http://127.0.0.1:1990/api/frame.jpeg?src=cam01
# RTSP_URL=rtsp://USER:PASS@CAMERA_IP:554/stream1

# Performance
# INTERVAL_S=0.5
# MAX_CONCURRENT_INFERENCE=1
# STREAM_RECONNECT_S=0.5
# STREAM_CAPTURE_INTERVAL_S=0.1
# DETECTION_MODE=tiles_2x2
# CLASS_IDENTITY_REMAP=false
# HUD_PROPOSAL=true
# IMGSZ=640
# ANNOTATE_FRAMES=false

# YOLO recall vs HUD (never below 0.70). Laravel Settings override HUD/record at runtime.
# CONF=0.70
# PROPOSAL_CONF=0.25
# RECORD_CONF=0.80

# OpenCV MOG2 motion detection (complements YOLO; never gates inference).
# MOTION_MIN_AREA=800
# MOTION_HISTORY=120
# MOTION_VAR_THRESHOLD=40
# MOTION_DETECT_SHADOWS=true
# MOTION_MORPH_KERNEL=5
# MOTION_LEARNING_RATE=-1
# MOTION_BOX_FRACTION=0.08
# MOTION_DEBUG=false
# MOTION_RESET_AFTER_MISSES=5

# Laravel API (detector posts live boxes here)
# API_BASE=http://127.0.0.1:8000/api
# DETECTOR_KEY=tidalwatch-detector-local

# Roboflow — download datasets + optional cloud fallback
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=dioquino-jims-carl-k
ROBOFLOW_PUBLISHABLE_KEY=
ROBOFLOW_MODEL_IDS=
ROBOFLOW_PRIMARY=yolov7-trash-05-04-2023-by3ff/1
# Live frames go to this workflow when set (Bearer auth, image input only).
ROBOFLOW_WORKFLOW_ID=local-datasets-vlocal-datasets-fgmmm-2-yolo11n-t1-logic

# merge_train_expand8.py: omit = auto-train when best.pt missing/stale
# export ROBOFLOW_TRAIN=1 to force, =0 to skip (Git Bash; not Windows `set`)
ROBOFLOW_TRAIN=

# Classes the live detector ignores (never drawn, saved, or sent to reviews)
EXCLUDED_CLASSES=Cardboard,Paper Drink Carton,Paper Bag,Plastic Bag

# Mark waste Confirmed Cleaned after it is missing this many seconds
# (and at least ABSENCE_MIN_FRAMES processed frames). 0 = use ABSENCE_FRAMES.
ABSENCE_SECONDS=20
ABSENCE_MIN_FRAMES=3
