MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Coastal Waste Monitoring System"

QUEUE_CONNECTION=database

ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=dioquino-jims-carl-k
ROBOFLOW_PROJECT=local-datasets
ROBOFLOW_MODEL_TYPE=yolov11
