APP_NAME=CoastalWastePlatform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coastal_waste_monitoring_reporting_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Shared with detector/.env — required for POST /api/detections/live
DETECTOR_KEY=tidalwatch-detector-local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Coastal Waste Monitoring System"

# Database queue: run `php artisan queue:work --tries=1 --timeout=600` beside `php artisan serve`.
QUEUE_CONNECTION=database

ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=dirks-workspace-aiipj
ROBOFLOW_PROJECT=local-ruwza-dgl85
ROBOFLOW_MODEL_TYPE=yolov11l
ROBOFLOW_SPEED=fast
ROBOFLOW_EPOCHS=350
ROBOFLOW_API_URL=https://api.roboflow.com
ROBOFLOW_VERIFY_SSL=true

# Video gateway (go2rtc). The API adds IP cameras from the dashboard here.
GO2RTC_BASE=http://127.0.0.1:1990
# Address the browser uses for camera video (set to the server address when deployed).
GO2RTC_PUBLIC_BASE=http://127.0.0.1:1990
