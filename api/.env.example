APP_NAME=CoastalWastePlatform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coastal_waste_monitoring_reporting_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Shared with detector/.env — required for POST /api/detections/live
DETECTOR_KEY=tidalwatch-detector-local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
