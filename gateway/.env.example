# First Tapo C545D RTSP Camera Account (not Tapo cloud login)
TAPO_RTSP_USER=your_rtsp_username
TAPO_RTSP_PASS=your_rtsp_password
TAPO_HOST=192.168.1.9

# Second Tapo C545D (Paco). Create a Camera Account on that device in the Tapo app.
# Leave the user and password empty until that account exists. Do not copy the first camera's password.
TAPO2_RTSP_USER=
TAPO2_RTSP_PASS=
TAPO2_HOST=192.168.1.8
